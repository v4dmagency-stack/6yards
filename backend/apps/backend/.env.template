# Copy to .env for local development. In production set these in
# Vercel -> Project -> Settings -> Environment Variables (never commit real values).

# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa_6yards
REDIS_URL=redis://localhost:6379
# Two different long random strings (e.g. `openssl rand -hex 32`)
JWT_SECRET=
COOKIE_SECRET=

# Allowed origins (comma separated). Use the live domain in production, e.g.
# STORE_CORS=https://www.example.com,https://example.com
STORE_CORS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:8000,http://localhost:5173,http://localhost:9000

MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Optional: S3-compatible storage for product images uploaded in Admin
# (AWS S3, Cloudflare R2, Supabase Storage...). Strongly recommended in production.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FILE_URL=

# Optional: stock given to products without inventory by prepare-store.ts
DEFAULT_STOCK_QUANTITY=5

# Not wired up yet (Razorpay / Resend need a plugin + keys; see docs/HANDOVER.md)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
